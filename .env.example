# Database Configuration
# For local MongoDB: mongodb://127.0.0.1:27017/GoSmoothie
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/GoSmoothie?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/GoSmoothie?retryWrites=true&w=majority

# Server Configuration
PORT=3000

# JWT Secret for token signing (change this to a secure random string in production)
JWT_SECRET=your_super_secret_key_change_me_in_production

# Stripe Integration (optional)
# Get your keys from https://dashboard.stripe.com/keys
# Leave empty to disable Stripe payment
STRIPE_SECRET=sk_test_your_stripe_secret_key

# Cash on Delivery
# COD_ENABLED: set to false to hide Cash on Delivery at checkout (default true)
# COD_MAX_TOTAL: highest order total (INR) eligible for Cash on Delivery (default 2000)
COD_ENABLED=true
COD_MAX_TOTAL=2000

# Node Environment
NODE_ENV=development
